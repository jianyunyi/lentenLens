code-creation,Eval,9,229899,0xd542bd9670,5, C:\\Users\\asus\\Documents\\Codex\\2026-10-06\\new-chat\\outputs\\intentlens\\extension\\test\\benchmarks\\callpath-bench.js:1:1,0xd39e529b48,~
script-source,118,C:\\Users\\asus\\Documents\\Codex\\2026-10-06\\new-chat\\outputs\\intentlens\\extension\\test\\benchmarks\\callpath-bench.js,/**\n * Call Path Provider Benchmarks - Tree Processing Performance\n * \n * Measures performance of EnhancedCallPathProvider tree operations:\n * - getChildren() at varying tree depths\n * - sortChildren() with varying child count\n * - Recursive tree expansion\n * - Search filtering on tree\n * - Tree structure memory usage\n */\n\nconst PerformanceMonitor = require('../profiling/PerformanceMonitor');\nconst { generateCallTree\x2C getTreeStats } = require('../fixtures/tree-fixtures');\n\n// Mock vscode API for provider initialization\nconst mockVscode = {\n  TreeItemCollapsibleState: {\n    None: 0\x2C\n    Collapsed: 1\x2C\n    Expanded: 2\x2C\n  }\x2C\n  TreeItem: function(label\x2C state) {\n    this.label = label;\n    this.collapsibleState = state;\n  }\x2C\n  ThemeIcon: function(name\x2C color) {\n    this.id = name;\n    this.color = color;\n  }\x2C\n  ThemeColor: function(name) {\n    this.name = name;\n  }\x2C\n  MarkdownString: function(str) {\n    this.value = str;\n  }\x2C\n  EventEmitter: function() {\n    this.event = null;\n    this.fire = function() {};\n  }\x2C\n};\n\n/**\n * Benchmark 1: getChildren() at varying tree depths\n * Generates call trees with depth 10\x2C 15\x2C 20\x2C 30\n * Measures time to getChildren() for different tree sizes\n */\nasync function benchmarkGetChildrenDepth() {\n  const monitor = new PerformanceMonitor();\n  const EnhancedCallPathProvider = require('../../src/callpath-enhanced').EnhancedCallPathProvider;\n  \n  const depths = [10\x2C 15\x2C 20\x2C 30];\n  const iterations = 10;\n  \n  for (const depth of depths) {\n    const opName = `getChildren-depth-${depth}`;\n    \n    for (let i = 0; i < iterations; i++) {\n      // Generate tree with deterministic seed\n      monitor.start(opName);\n      \n      const tree = generateCallTree(depth\x2C 3\x2C 42 + i);\n      const provider = new EnhancedCallPathProvider(mockVscode);\n      provider.setCallTree(tree);\n      \n      // Measure getChildren() at different levels\n      const root = provider.getChildren(undefined);\n      if (root && root.length > 0) {\n        provider.getChildren(root[0]);\n      }\n      \n      monitor.end(opName);\n    }\n  }\n  \n  // Aggregate results from all depths\n  const aggregated = {\n    name: 'Call Path: getChildren() at Varying Tree Depths'\x2C\n    benchmarks: []\x2C\n    totalIterations: 0\n  };\n  \n  for (const depth of depths) {\n    const report = monitor.report(`getChildren-depth-${depth}`);\n    aggregated.benchmarks.push({\n      depth\x2C\n      latency: report.latency\x2C\n      memoryDelta: report.memoryDelta\x2C\n      gcCount: report.gcCount\x2C\n      gcTotalTime: report.gcTotalTime\n    });\n    aggregated.totalIterations += report.iterations;\n  }\n  \n  monitor.destroy();\n  return aggregated;\n}\n\n/**\n * Benchmark 2: sortChildren() with varying child count\n * Generates node with 100\x2C 500\x2C 1k children\n * Measures time to sort children by execution time\n */\nasync function benchmarkSortChildren() {\n  const monitor = new PerformanceMonitor();\n  const EnhancedCallPathProvider = require('../../src/callpath-enhanced').EnhancedCallPathProvider;\n  \n  const childCounts = [100\x2C 500\x2C 1000];\n  const iterations = 10;\n  \n  for (const count of childCounts) {\n    const opName = `sortChildren-count-${count}`;\n    \n    for (let i = 0; i < iterations; i++) {\n      monitor.start(opName);\n      \n      // Generate a parent node with many children\n      const children = [];\n      for (let j = 0; j < count; j++) {\n        children.push({\n          id: `child-${j}`\x2C\n          name: `Function ${j}`\x2C\n          line: Math.floor(Math.random() * 1000) + 1\x2C\n          executionTime: Math.random() * 1000\x2C\n          callCount: Math.floor(Math.random() * 100) + 1\x2C\n          children: []\n        });\n      }\n      \n      const parentNode = {\n        id: 'parent'\x2C\n        name: 'Parent Function'\x2C\n        line: 1\x2C\n        children: children\n      };\n      \n      const provider = new EnhancedCallPathProvider(mockVscode);\n      provider.setCallTree(parentNode);\n      provider.setSortBy('executionTime');\n      \n      // Measure sortNodes() call\n      const root = provider.getChildren(undefined);\n      if (root && root.length > 0) {\n        provider.sortNodes(root[0].children);\n      }\n      \n      monitor.end(opName);\n    }\n  }\n  \n  // Aggregate results\n  const aggregated = {\n    name: 'Call Path: sortChildren() with Varying Child Count'\x2C\n    benchmarks: []\x2C\n    totalIterations: 0\n  };\n  \n  for (const count of childCounts) {\n    const report = monitor.report(`sortChildren-count-${count}`);\n    aggregated.benchmarks.push({\n      childCount: count\x2C\n      latency: report.latency\x2C\n      memoryDelta: report.memoryDelta\x2C\n      gcCount: report.gcCount\x2C\n      gcTotalTime: report.gcTotalTime\n    });\n    aggregated.totalIterations += report.iterations;\n  }\n  \n  monitor.destroy();\n  return aggregated;\n}\n\n/**\n * Benchmark 3: Recursive tree expansion\n * Expands tree 3 levels deep from root\n * Measures total expansion time\n */\nasync function benchmarkRecursiveExpansion() {\n  const monitor = new PerformanceMonitor();\n  const EnhancedCallPathProvider = require('../../src/callpath-enhanced').EnhancedCallPathProvider;\n  \n  const depths = [10\x2C 15\x2C 20\x2C 30];\n  const expandDepth = 3; // How many levels to expand\n  const iterations = 10;\n  \n  for (const depth of depths) {\n    const opName = `recursive-expand-depth-${depth}`;\n    \n    for (let i = 0; i < iterations; i++) {\n      monitor.start(opName);\n      \n      const tree = generateCallTree(depth\x2C 3\x2C 42 + i);\n      const provider = new EnhancedCallPathProvider(mockVscode);\n      provider.setCallTree(tree);\n      \n      // Recursively expand tree to specified depth\n      function expandTree(node\x2C currentDepth) {\n        if (currentDepth >= expandDepth || !node) return;\n        \n        const children = provider.getChildren(node);\n        for (const child of children) {\n          expandTree(child\x2C currentDepth + 1);\n        }\n      }\n      \n      const root = provider.getChildren(undefined);\n      if (root && root.length > 0) {\n        expandTree(root[0]\x2C 0);\n      }\n      \n      monitor.end(opName);\n    }\n  }\n  \n  // Aggregate results\n  const aggregated = {\n    name: 'Call Path: Recursive Tree Expansion'\x2C\n    expandDepth: 3\x2C\n    benchmarks: []\x2C\n    totalIterations: 0\n  };\n  \n  for (const depth of depths) {\n    const report = monitor.report(`recursive-expand-depth-${depth}`);\n    aggregated.benchmarks.push({\n      treeDepth: depth\x2C\n      latency: report.latency\x2C\n      memoryDelta: report.memoryDelta\x2C\n      gcCount: report.gcCount\x2C\n      gcTotalTime: report.gcTotalTime\n    });\n    aggregated.totalIterations += report.iterations;\n  }\n  \n  monitor.destroy();\n  return aggregated;\n}\n\n/**\n * Benchmark 4: Search filtering on tree\n * Search for functions in tree (depth 20)\n * Measures time to filter/search\n */\nasync function benchmarkSearchFiltering() {\n  const monitor = new PerformanceMonitor();\n  const EnhancedCallPathProvider = require('../../src/callpath-enhanced').EnhancedCallPathProvider;\n  \n  const searchPatterns = [\n    { query: 'Function'\x2C expectedMatches: 'many' }\x2C\n    { query: 'Function 5'\x2C expectedMatches: 'few' }\x2C\n    { query: 'Function 99'\x2C expectedMatches: 'few' }\n  ];\n  \n  const iterations = 10;\n  \n  for (const pattern of searchPatterns) {\n    const opName = `search-${pattern.query.replace(/\\s/g\x2C '-')}`;\n    \n    for (let i = 0; i < iterations; i++) {\n      monitor.start(opName);\n      \n      // Generate tree with depth 20 for search test\n      const tree = generateCallTree(20\x2C 3\x2C 42 + i);\n      const provider = new EnhancedCallPathProvider(mockVscode);\n      provider.setCallTree(tree);\n      \n      // Perform search\n      const results = provider.search(pattern.query);\n      \n      monitor.end(opName);\n    }\n  }\n  \n  // Aggregate results\n  const aggregated = {\n    name: 'Call Path: Search Filtering on Tree'\x2C\n    treeDepth: 20\x2C\n    benchmarks: []\x2C\n    totalIterations: 0\n  };\n  \n  for (const pattern of searchPatterns) {\n    const opName = `search-${pattern.query.replace(/\\s/g\x2C '-')}`;\n    const report = monitor.report(opName);\n    aggregated.benchmarks.push({\n      searchQuery: pattern.query\x2C\n      expectedMatches: pattern.expectedMatches\x2C\n      latency: report.latency\x2C\n      memoryDelta: report.memoryDelta\x2C\n      gcCount: report.gcCount\x2C\n      gcTotalTime: report.gcTotalTime\n    });\n    aggregated.totalIterations += report.iterations;\n  }\n  \n  monitor.destroy();\n  return aggregated;\n}\n\n/**\n * Benchmark 5: Tree structure memory usage\n * Load complete tree\x2C measure memory delta\n */\nasync function benchmarkMemoryUsage() {\n  const monitor = new PerformanceMonitor();\n  const EnhancedCallPathProvider = require('../../src/callpath-enhanced').EnhancedCallPathProvider;\n  \n  const depths = [10\x2C 15\x2C 20\x2C 25];\n  const iterations = 10;\n  \n  for (const depth of depths) {\n    const opName = `memory-depth-${depth}`;\n    \n    for (let i = 0; i < iterations; i++) {\n      monitor.start(opName);\n      \n      const tree = generateCallTree(depth\x2C 3\x2C 42 + i);\n      const stats = getTreeStats(tree);\n      \n      const provider = new EnhancedCallPathProvider(mockVscode);\n      provider.setCallTree(tree);\n      \n      // Force accessing all nodes to ensure they're in memory\n      function traverseAll(node) {\n        provider.getChildren(node);\n        if (node && node.children) {\n          for (const child of node.children) {\n            traverseAll(child);\n          }\n        }\n      }\n      \n      const root = provider.getChildren(undefined);\n      if (root && root.length > 0) {\n        traverseAll(root[0]);\n      }\n      \n      monitor.end(opName);\n    }\n  }\n  \n  // Aggregate results with tree stats\n  const aggregated = {\n    name: 'Call Path: Tree Structure Memory Usage'\x2C\n    benchmarks: []\x2C\n    totalIterations: 0\n  };\n  \n  for (const depth of depths) {\n    const opName = `memory-depth-${depth}`;\n    const report = monitor.report(opName);\n    \n    // Generate sample tree to get stats\n    const tree = generateCallTree(depth\x2C 3\x2C 42);\n    const stats = getTreeStats(tree);\n    \n    aggregated.benchmarks.push({\n      depth\x2C\n      nodeCount: stats.nodeCount\x2C\n      maxDepth: stats.maxDepth\x2C\n      avgChildren: stats.avgChildren\x2C\n      latency: report.latency\x2C\n      memoryDelta: report.memoryDelta\x2C\n      gcCount: report.gcCount\x2C\n      gcTotalTime: report.gcTotalTime\n    });\n    aggregated.totalIterations += report.iterations;\n  }\n  \n  monitor.destroy();\n  return aggregated;\n}\n\n/**\n * Main benchmark runner - executes all benchmarks and returns results\n */\nasync function runCallPathBench() {\n  console.log('\ud83d\ude80 Starting Call Path Provider Benchmarks...\\n');\n  \n  const results = {\n    benchmarks: []\n  };\n  \n  try {\n    console.log('\ud83d\udcca Benchmark 1: getChildren() at Varying Tree Depths');\n    const bench1 = await benchmarkGetChildrenDepth();\n    results.benchmarks.push(bench1);\n    console.log(`   \u2713 Completed ${bench1.totalIterations} iterations`);\n    console.log(`   Latency (p50/p95/p99): ${bench1.benchmarks.map(b => `${b.latency.p50.toFixed(2)}/${b.latency.p95.toFixed(2)}/${b.latency.p99.toFixed(2)}ms`).join('\x2C ')}\\n`);\n    \n    console.log('\ud83d\udcca Benchmark 2: sortChildren() with Varying Child Count');\n    const bench2 = await benchmarkSortChildren();\n    results.benchmarks.push(bench2);\n    console.log(`   \u2713 Completed ${bench2.totalIterations} iterations`);\n    console.log(`   Latency (p50/p95/p99): ${bench2.benchmarks.map(b => `${b.latency.p50.toFixed(2)}/${b.latency.p95.toFixed(2)}/${b.latency.p99.toFixed(2)}ms`).join('\x2C ')}\\n`);\n    \n    console.log('\ud83d\udcca Benchmark 3: Recursive Tree Expansion');\n    const bench3 = await benchmarkRecursiveExpansion();\n    results.benchmarks.push(bench3);\n    console.log(`   \u2713 Completed ${bench3.totalIterations} iterations`);\n    console.log(`   Latency (p50/p95/p99): ${bench3.benchmarks.map(b => `${b.latency.p50.toFixed(2)}/${b.latency.p95.toFixed(2)}/${b.latency.p99.toFixed(2)}ms`).join('\x2C ')}\\n`);\n    \n    console.log('\ud83d\udcca Benchmark 4: Search Filtering on Tree');\n    const bench4 = await benchmarkSearchFiltering();\n    results.benchmarks.push(bench4);\n    console.log(`   \u2713 Completed ${bench4.totalIterations} iterations`);\n    console.log(`   Latency (p50/p95/p99): ${bench4.benchmarks.map(b => `${b.latency.p50.toFixed(2)}/${b.latency.p95.toFixed(2)}/${b.latency.p99.toFixed(2)}ms`).join('\x2C ')}\\n`);\n    \n    console.log('\ud83d\udcca Benchmark 5: Tree Structure Memory Usage');\n    const bench5 = await benchmarkMemoryUsage();\n    results.benchmarks.push(bench5);\n    console.log(`   \u2713 Completed ${bench5.totalIterations} iterations`);\n    console.log(`   Latency (p50/p95/p99): ${bench5.benchmarks.map(b => `${b.latency.p50.toFixed(2)}/${b.latency.p95.toFixed(2)}/${b.latency.p99.toFixed(2)}ms`).join('\x2C ')}\\n`);\n    \n    console.log('\u2705 All benchmarks completed successfully!\\n');\n  } catch (error) {\n    console.error('\u274c Benchmark execution failed:'\x2C error);\n    throw error;\n  }\n  \n  return results;\n}\n\nmodule.exports = {\n  name: 'Call Path: Tree Processing Performance'\x2C\n  run: runCallPathBench\x2C\n  benchmarks: {\n    benchmarkGetChildrenDepth\x2C\n    benchmarkSortChildren\x2C\n    benchmarkRecursiveExpansion\x2C\n    benchmarkSearchFiltering\x2C\n    benchmarkMemoryUsage\n  }\n};\n
