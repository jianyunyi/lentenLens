script-source,106,C:\\Users\\asus\\Documents\\Codex\\2026-10-06\\new-chat\\outputs\\intentlens\\extension\\test\\profiling\\PerformanceMonitor.js,/**\n * PerformanceMonitor - Records and analyzes operation performance metrics.\n * Measures latency\x2C memory delta\x2C and GC pauses for benchmarking.\n */\n\nconst { performance\x2C PerformanceObserver } = require('node:perf_hooks');\n\nclass PerformanceMonitor {\n  constructor() {\n    // Store samples: { name -> [{ latency\x2C memory\x2C gcEvents }] }\n    this.samples = new Map();\n    \n    // Store active measurements\n    this.active = new Map();\n    \n    // GC observer for tracking GC pauses\n    this.gcObserver = null;\n    this.gcEvents = [];\n    \n    this._initGCObserver();\n  }\n\n  /**\n   * Initialize GC observer to track garbage collection pauses\n   * @private\n   */\n  _initGCObserver() {\n    try {\n      this.gcObserver = new PerformanceObserver((list) => {\n        for (const entry of list.getEntries()) {\n          if (entry.kind !== undefined) {\n            // entry.kind: 1=Scavenge\x2C 2=MarkSweepCompact\x2C 4=IncrementalMarking\n            this.gcEvents.push({\n              type: entry.kind\x2C\n              duration: entry.duration\x2C\n              startTime: entry.startTime\n            });\n          }\n        }\n      });\n      \n      // Observe PerformanceObserver with 'gc' entry type\n      this.gcObserver.observe({ entryTypes: ['gc']\x2C buffered: true });\n    } catch (e) {\n      // GC observation not available\x2C continue without it\n      this.gcObserver = null;\n    }\n  }\n\n  /**\n   * Start measuring an operation\n   * @param {string} name - Operation name\n   */\n  start(name) {\n    if (this.active.has(name)) {\n      throw new Error(`Measurement '${name}' is already active`);\n    }\n\n    const memBefore = process.memoryUsage();\n    const startTime = performance.now();\n    const gcCountBefore = this.gcEvents.length;\n\n    this.active.set(name\x2C {\n      startTime\x2C\n      memBefore\x2C\n      gcCountBefore\n    });\n  }\n\n  /**\n   * End measuring an operation and record the sample\n   * @param {string} name - Operation name\n   */\n  end(name) {\n    if (!this.active.has(name)) {\n      throw new Error(`Measurement '${name}' is not active`);\n    }\n\n    const endTime = performance.now();\n    const memAfter = process.memoryUsage();\n    const gcCountAfter = this.gcEvents.length;\n\n    const measurement = this.active.get(name);\n    this.active.delete(name);\n\n    const latency = endTime - measurement.startTime;\n    \n    // Calculate memory delta in bytes\n    const memoryDelta = {\n      heapUsed: memAfter.heapUsed - measurement.memBefore.heapUsed\x2C\n      heapTotal: memAfter.heapTotal - measurement.memBefore.heapTotal\x2C\n      external: memAfter.external - measurement.memBefore.external\x2C\n      rss: memAfter.rss - measurement.memBefore.rss\n    };\n\n    // Calculate GC metrics for this operation\n    const operationGCEvents = this.gcEvents.slice(measurement.gcCountBefore\x2C gcCountAfter);\n    const gcMetrics = {\n      count: operationGCEvents.length\x2C\n      totalDuration: operationGCEvents.reduce((sum\x2C e) => sum + e.duration\x2C 0)\n    };\n\n    if (!this.samples.has(name)) {\n      this.samples.set(name\x2C []);\n    }\n\n    this.samples.get(name).push({\n      latency\x2C\n      memoryDelta\x2C\n      gcMetrics\n    });\n  }\n\n  /**\n   * Reset all samples for a given operation (or all if not specified)\n   * @param {string} [name] - Operation name to reset\x2C or undefined for all\n   */\n  reset(name) {\n    if (name !== undefined) {\n      this.samples.delete(name);\n    } else {\n      this.samples.clear();\n    }\n    this.gcEvents = [];\n  }\n\n  /**\n   * Calculate percentiles from sorted array of values\n   * @param {number[]} sorted - Sorted array of values\n   * @param {number} percentile - Percentile (0-100)\n   * @returns {number} Percentile value\n   * @private\n   */\n  _percentile(sorted\x2C percentile) {\n    if (sorted.length === 0) return 0;\n    const index = (percentile / 100) * (sorted.length - 1);\n    const lower = Math.floor(index);\n    const upper = Math.ceil(index);\n    const weight = index % 1;\n\n    if (lower === upper) {\n      return sorted[lower];\n    }\n    return sorted[lower] * (1 - weight) + sorted[upper] * weight;\n  }\n\n  /**\n   * Generate a performance report for an operation\n   * @param {string} name - Operation name\n   * @returns {Object} Report object with latency stats\x2C memory\x2C and GC metrics\n   */\n  report(name) {\n    if (!this.samples.has(name) || this.samples.get(name).length === 0) {\n      return {\n        name\x2C\n        iterations: 0\x2C\n        latency: { p50: 0\x2C p95: 0\x2C p99: 0\x2C min: 0\x2C max: 0 }\x2C\n        memoryDelta: { heapUsed: 0\x2C heapTotal: 0\x2C external: 0\x2C rss: 0 }\x2C\n        gcCount: 0\x2C\n        gcTotalTime: 0\n      };\n    }\n\n    const samples = this.samples.get(name);\n    const latencies = samples.map(s => s.latency).sort((a\x2C b) => a - b);\n    \n    // Calculate latency percentiles\n    const report = {\n      name\x2C\n      iterations: samples.length\x2C\n      latency: {\n        p50: this._percentile(latencies\x2C 50)\x2C\n        p95: this._percentile(latencies\x2C 95)\x2C\n        p99: this._percentile(latencies\x2C 99)\x2C\n        min: latencies[0]\x2C\n        max: latencies[latencies.length - 1]\x2C\n        mean: latencies.reduce((a\x2C b) => a + b\x2C 0) / latencies.length\n      }\x2C\n      memoryDelta: {\n        heapUsed: samples.reduce((sum\x2C s) => sum + s.memoryDelta.heapUsed\x2C 0) / samples.length\x2C\n        heapTotal: samples.reduce((sum\x2C s) => sum + s.memoryDelta.heapTotal\x2C 0) / samples.length\x2C\n        external: samples.reduce((sum\x2C s) => sum + s.memoryDelta.external\x2C 0) / samples.length\x2C\n        rss: samples.reduce((sum\x2C s) => sum + s.memoryDelta.rss\x2C 0) / samples.length\n      }\x2C\n      gcCount: samples.reduce((sum\x2C s) => sum + s.gcMetrics.count\x2C 0)\x2C\n      gcTotalTime: samples.reduce((sum\x2C s) => sum + s.gcMetrics.totalDuration\x2C 0)\n    };\n\n    return report;\n  }\n\n  /**\n   * Get all reports for all measured operations\n   * @returns {Object[]} Array of report objects\n   */\n  reportAll() {\n    const reports = [];\n    for (const name of this.samples.keys()) {\n      reports.push(this.report(name));\n    }\n    return reports;\n  }\n\n  /**\n   * Get raw samples for an operation (for advanced analysis)\n   * @param {string} name - Operation name\n   * @returns {Object[]} Array of sample objects\n   */\n  getSamples(name) {\n    return this.samples.get(name) || [];\n  }\n\n  /**\n   * Cleanup resources\n   */\n  destroy() {\n    if (this.gcObserver) {\n      this.gcObserver.disconnect();\n      this.gcObserver = null;\n    }\n    this.samples.clear();\n    this.active.clear();\n    this.gcEvents = [];\n  }\n}\n\nmodule.exports = PerformanceMonitor;\n
