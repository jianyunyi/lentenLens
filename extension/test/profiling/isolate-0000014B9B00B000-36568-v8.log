script-source,119,C:\\Users\\asus\\Documents\\Codex\\2026-10-06\\new-chat\\outputs\\intentlens\\extension\\test\\fixtures\\tree-fixtures.js,/**\n * Tree Fixtures - Generate deterministic call tree structures\n */\n\n/**\n * Simple seeded random number generator for reproducibility\n * @param {number} seed - Seed value\n * @returns {() => number} Function that returns pseudo-random numbers [0\x2C 1)\n */\nfunction createSeededRandom(seed) {\n  let value = seed;\n  return () => {\n    value = (value * 9301 + 49297) % 233280;\n    return value / 233280;\n  };\n}\n\n/**\n * Generate a call tree with configurable depth and branching\n * @param {number} depth - Maximum tree depth\n * @param {number} [branchingFactor=2] - Average children per node\n * @param {number} [seed=42] - Seed for reproducibility\n * @returns {Object} Root node of the tree\n */\nfunction generateCallTree(depth\x2C branchingFactor = 2\x2C seed = 42) {\n  const random = createSeededRandom(seed);\n  let nodeId = 0;\n\n  function buildNode(currentDepth) {\n    const id = nodeId++;\n    const numChildren = currentDepth < depth \n      ? Math.floor(random() * (branchingFactor + 1))\n      : 0;\n\n    const node = {\n      id: `node-${id}`\x2C\n      name: `Function ${id}`\x2C\n      line: Math.floor(random() * 1000) + 1\x2C\n      children: []\n    };\n\n    for (let i = 0; i < numChildren; i++) {\n      node.children.push(buildNode(currentDepth + 1));\n    }\n\n    return node;\n  }\n\n  return buildNode(0);\n}\n\n/**\n * Calculate statistics about a tree\n * @param {Object} node - Root node\n * @returns {Object} Statistics object\n */\nfunction getTreeStats(node) {\n  let nodeCount = 0;\n  let maxDepth = 0;\n  let totalChildren = 0;\n\n  function traverse(n\x2C depth) {\n    nodeCount++;\n    maxDepth = Math.max(maxDepth\x2C depth);\n    totalChildren += n.children.length;\n    \n    for (const child of n.children) {\n      traverse(child\x2C depth + 1);\n    }\n  }\n\n  traverse(node\x2C 0);\n\n  return {\n    nodeCount\x2C\n    maxDepth\x2C\n    avgChildren: totalChildren / Math.max(1\x2C nodeCount)\n  };\n}\n\nmodule.exports = {\n  generateCallTree\x2C\n  getTreeStats\x2C\n  createSeededRandom\n};\n
