code-creation,Eval,9,304608,0xd542be6d68,5, C:\\Users\\asus\\Documents\\Codex\\2026-10-06\\new-chat\\outputs\\intentlens\\extension\\src\\callpath-enhanced.js:1:1,0x2d4eb8be2d0,~
script-source,123,C:\\Users\\asus\\Documents\\Codex\\2026-10-06\\new-chat\\outputs\\intentlens\\extension\\src\\callpath-enhanced.js,\ufeff'use strict';\n\n/**\n * Enhanced Call Path Provider\n * \u663e\u793a\u51fd\u6570\u8c03\u7528\u94fe\u53ca\u5176\u6027\u80fd\u6307\u6807\n */\n\nclass CallPathNode {\n  constructor(vscode\x2C data\x2C parentExecutionTime = 0) {\n    this.vscode = vscode;\n    this.name = data.name || 'unknown';\n    this.file = data.file;\n    this.line = data.line;\n    this.column = data.column;\n    this.executionTime = data.executionTime || 0;\n    this.callCount = data.callCount || 1;\n    this.memory = data.memory || 0;\n    this.cpu = data.cpu || 0;\n    this.children = (data.children || []).map(\n      child => new CallPathNode(vscode\x2C child\x2C this.executionTime)\n    );\n    this.parentExecutionTime = parentExecutionTime;\n  }\n\n  getTreeItem() {\n    const timePercent = this.parentExecutionTime > 0 ? \n      ((this.executionTime / this.parentExecutionTime) * 100).toFixed(1) : \n      '0.0';\n\n    const label = `${this.name} [${this.executionTime}ms \xb7 ${timePercent}%]`;\n    \n    const item = new this.vscode.TreeItem(\n      label\x2C\n      this.children.length > 0 ?\n        this.vscode.TreeItemCollapsibleState.Collapsed :\n        this.vscode.TreeItemCollapsibleState.None\n    );\n\n    // \u6839\u636e\u6267\u884c\u65f6\u95f4\u9009\u62e9\u56fe\u6807\n    item.iconPath = this.getIconByPerformance();\n    \n    // \u8be6\u7ec6\u4fe1\u606f\n    item.description = `${this.callCount} calls \xb7 ${this.memory}MB \xb7 ${this.cpu}%CPU`;\n    \n    // \u5feb\u901f\u94fe\u63a5\u5230\u6e90\u4ee3\u7801\n    item.command = {\n      command: 'intentlens.callpath.goto'\x2C\n      title: 'Go to Code'\x2C\n      arguments: [this.file\x2C this.line\x2C this.column]\x2C\n    };\n\n    // \u4e0a\u4e0b\u6587\u83dc\u5355\n    item.contextValue = 'intentlens.callpath.node';\n    \n    // \u60ac\u505c\u63d0\u793a\n    item.tooltip = this.buildTooltip();\n\n    return item;\n  }\n\n  /**\n   * \u6839\u636e\u6027\u80fd\u9009\u62e9\u56fe\u6807\n   */\n  getIconByPerformance() {\n    if (this.executionTime > 1000) {\n      return new this.vscode.ThemeIcon('error'\x2C \n        new this.vscode.ThemeColor('errorForeground'));\n    }\n    if (this.executionTime > 500) {\n      return new this.vscode.ThemeIcon('warning'\x2C\n        new this.vscode.ThemeColor('warningForeground'));\n    }\n    if (this.executionTime > 200) {\n      return new this.vscode.ThemeIcon('info'\x2C\n        new this.vscode.ThemeColor('infoPoreground'));\n    }\n    return new this.vscode.ThemeIcon('pass'\x2C\n      new this.vscode.ThemeColor('testing.iconPassed'));\n  }\n\n  /**\n   * \u6784\u5efa\u60ac\u505c\u63d0\u793a\n   */\n  buildTooltip() {\n    const parts = [\n      `## \ud83d\udcde ${this.name}`\x2C\n      ''\x2C\n      `**\u6587\u4ef6**: ${this.file}:${this.line}`\x2C\n      `**\u6267\u884c\u65f6\u95f4**: ${this.executionTime}ms`\x2C\n      `**\u8c03\u7528\u6b21\u6570**: ${this.callCount}`\x2C\n      `**\u5185\u5b58\u5206\u914d**: ${this.memory}MB`\x2C\n      `**CPU\u5360\u7528**: ${this.cpu}%`\x2C\n    ];\n\n    if (this.children.length > 0) {\n      parts.push('');\n      parts.push('### \u5b50\u51fd\u6570\u8c03\u7528:');\n      for (const child of this.children) {\n        parts.push(`- ${child.name} (${child.executionTime}ms)`);\n      }\n    }\n\n    return new this.vscode.MarkdownString(parts.join('\\n'));\n  }\n}\n\nclass EnhancedCallPathProvider {\n  constructor(vscode\x2C onDidChangeTreeData) {\n    this.vscode = vscode;\n    this._onDidChangeTreeData = new vscode.EventEmitter();\n    this.onDidChangeTreeData = this._onDidChangeTreeData.event;\n    this._callTree = null;\n    this._sortBy = 'executionTime'; // executionTime\x2C name\x2C callCount\n    this._filterThreshold = 0; // \u6700\u5c0f\u6267\u884c\u65f6\u95f4 (ms)\n    this._flattenedNodes = [];\n  }\n\n  /**\n   * \u8bbe\u7f6e\u8c03\u7528\u6811\u6570\u636e\n   */\n  setCallTree(callTreeData) {\n    this._callTree = new CallPathNode(this.vscode\x2C callTreeData);\n    this._flattenTree();\n    this.refresh();\n  }\n\n  /**\n   * \u5237\u65b0\u89c6\u56fe\n   */\n  refresh() {\n    this._onDidChangeTreeData.fire(undefined);\n  }\n\n  /**\n   * \u83b7\u53d6\u6811\u9879\n   */\n  getTreeItem(element) {\n    return element.getTreeItem();\n  }\n\n  /**\n   * \u83b7\u53d6\u5b50\u9879\n   */\n  getChildren(element) {\n    if (!element) {\n      return this._callTree ? [this._callTree] : [];\n    }\n    \n    return this.sortNodes(element.children);\n  }\n\n  /**\n   * \u6392\u5e8f\u8282\u70b9\n   */\n  sortNodes(nodes) {\n    const sorted = [...nodes];\n    \n    switch (this._sortBy) {\n      case 'executionTime':\n        sorted.sort((a\x2C b) => b.executionTime - a.executionTime);\n        break;\n      case 'name':\n        sorted.sort((a\x2C b) => a.name.localeCompare(b.name));\n        break;\n      case 'callCount':\n        sorted.sort((a\x2C b) => b.callCount - a.callCount);\n        break;\n    }\n    \n    return sorted;\n  }\n\n  /**\n   * \u5c55\u5e73\u6811\u4e3a\u5217\u8868 (\u7528\u4e8e\u5feb\u901f\u641c\u7d22)\n   */\n  _flattenTree(node = this._callTree\x2C result = []) {\n    if (!node) return result;\n    \n    result.push(node);\n    for (const child of node.children) {\n      this._flattenTree(child\x2C result);\n    }\n    \n    return result;\n  }\n\n  /**\n   * \u641c\u7d22\u51fd\u6570\n   */\n  search(query) {\n    const searchLower = query.toLowerCase();\n    return this._flattenedNodes.filter(node =>\n      node.name.toLowerCase().includes(searchLower) ||\n      node.file?.toLowerCase().includes(searchLower)\n    );\n  }\n\n  /**\n   * \u8bbe\u7f6e\u6392\u5e8f\u65b9\u5f0f\n   */\n  setSortBy(sortBy) {\n    this._sortBy = sortBy;\n    this.refresh();\n  }\n\n  /**\n   * \u8bbe\u7f6e\u6027\u80fd\u8fc7\u6ee4\u9608\u503c\n   */\n  setFilterThreshold(ms) {\n    this._filterThreshold = ms;\n    this.refresh();\n  }\n\n  /**\n   * \u5bfc\u51fa\u8c03\u7528\u56fe\n   */\n  exportAsText(node = this._callTree\x2C indent = 0) {\n    if (!node) return '';\n    \n    let result = '';\n    result += ' '.repeat(indent) + \n      `\u2514\u2500 ${node.name} [${node.executionTime}ms]\\n`;\n    \n    for (const child of node.children) {\n      result += this.exportAsText(child\x2C indent + 3);\n    }\n    \n    return result;\n  }\n\n  /**\n   * \u6ce8\u518c\u547d\u4ee4\n   */\n  registerCommands(context) {\n    context.subscriptions.push(\n      this.vscode.commands.registerCommand(\n        'intentlens.callpath.goto'\x2C\n        async (file\x2C line\x2C column) => {\n          const uri = this.vscode.Uri.file(file);\n          const doc = await this.vscode.workspace.openTextDocument(uri);\n          const editor = await this.vscode.window.showTextDocument(doc);\n          \n          const position = new this.vscode.Position(line - 1\x2C column - 1);\n          editor.selection = new this.vscode.Selection(position\x2C position);\n          editor.revealRange(\n            new this.vscode.Range(position\x2C position)\x2C\n            this.vscode.TextEditorRevealType.InCenter\n          );\n        }\n      )\n    );\n\n    context.subscriptions.push(\n      this.vscode.commands.registerCommand(\n        'intentlens.callpath.export'\x2C\n        () => {\n          const exported = this.exportAsText();\n          this.vscode.window.showInformationMessage('\u8c03\u7528\u56fe\u5df2\u5bfc\u51fa');\n          // \u590d\u5236\u5230\u526a\u8d34\u677f\n          this.vscode.env.clipboard.writeText(exported);\n        }\n      )\n    );\n\n    context.subscriptions.push(\n      this.vscode.commands.registerCommand(\n        'intentlens.callpath.sort'\x2C\n        async () => {\n          const sortBy = await this.vscode.window.showQuickPick([\n            { label: '\u23f1 \u6309\u6267\u884c\u65f6\u95f4'\x2C value: 'executionTime' }\x2C\n            { label: '\ud83d\udcdd \u6309\u540d\u79f0'\x2C value: 'name' }\x2C\n            { label: '\ud83d\udcca \u6309\u8c03\u7528\u6b21\u6570'\x2C value: 'callCount' }\x2C\n          ]\x2C { placeHolder: '\u9009\u62e9\u6392\u5e8f\u65b9\u5f0f' });\n          \n          if (sortBy) {\n            this.setSortBy(sortBy.value);\n          }\n        }\n      )\n    );\n  }\n}\n\nmodule.exports = {\n  EnhancedCallPathProvider\x2C\n  CallPathNode\x2C\n};\n
