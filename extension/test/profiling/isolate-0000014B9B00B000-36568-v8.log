script-source,122,C:\\Users\\asus\\Documents\\Codex\\2026-10-06\\new-chat\\outputs\\intentlens\\extension\\test\\benchmarks\\taskpanel-bench.js,/**\n * Task Management Panel Benchmarks\n * Measures performance of TaskManagementPanel interactions and form operations\n */\n\nconst PerformanceMonitor = require('../profiling/PerformanceMonitor');\nconst { generateTasks } = require('../fixtures/task-fixtures');\n\n// Mock VS Code API for isolation\nconst createMockVscode = () => ({\n  window: {\n    createWebviewPanel: () => ({\n      webview: {\n        onDidReceiveMessage: () => {}\x2C\n        html: ''\x2C\n      }\x2C\n      onDidDispose: () => {}\x2C\n      reveal: () => {}\x2C\n      dispose: () => {}\x2C\n    })\x2C\n    showInformationMessage: () => Promise.resolve()\x2C\n    showErrorMessage: () => Promise.resolve()\x2C\n    showInputBox: () => Promise.resolve()\x2C\n  }\x2C\n  ViewColumn: {\n    Beside: 2\x2C\n  }\x2C\n  Uri: {\n    file: (path) => ({ fsPath: path })\x2C\n  }\x2C\n});\n\nconst createMockContext = () => ({\n  subscriptions: []\x2C\n});\n\n// TaskManagementPanel class with benchmarkable methods\nclass TaskManagementPanel {\n  constructor(vscode\x2C extensionContext) {\n    this.vscode = vscode;\n    this.context = extensionContext;\n    this._tasks = new Map();\n    this._panel = null;\n    this._webviewReady = false;\n  }\n\n  async show() {\n    if (this._panel) {\n      this._panel.reveal(this.vscode.ViewColumn.Beside);\n      return;\n    }\n\n    this._panel = this.vscode.window.createWebviewPanel(\n      'intentlens.taskmanagement'\x2C\n      '\ud83d\udccb Task Management'\x2C\n      this.vscode.ViewColumn.Beside\x2C\n      {\n        enableScripts: true\x2C\n        enableFindWidget: true\x2C\n        retainContextWhenHidden: true\x2C\n      }\n    );\n\n    this._panel.webview.onDidReceiveMessage(\n      message => this.handleWebviewMessage(message)\n    );\n\n    this._panel.onDidDispose(() => {\n      this._panel = null;\n    });\n\n    this._panel.webview.html = this.getWebviewContent();\n  }\n\n  getWebviewContent() {\n    return `<!DOCTYPE html>\n      <html>\n      <head>\n        <meta charset="UTF-8">\n        <meta name="viewport" content="width=device-width\x2C initial-scale=1.0">\n        <style>\n          body {\n            font-family: var(--vscode-font-family);\n            background: var(--vscode-editor-background);\n            color: var(--vscode-editor-foreground);\n            margin: 0;\n            padding: 16px;\n          }\n          .container {\n            max-width: 800px;\n            margin: 0 auto;\n          }\n          h2 {\n            margin-top: 0;\n            border-bottom: 1px solid var(--vscode-panel-border);\n            padding-bottom: 8px;\n          }\n          .form-group {\n            margin-bottom: 16px;\n          }\n          label {\n            display: block;\n            margin-bottom: 4px;\n            font-weight: bold;\n          }\n          input[type="text"]\x2C textarea\x2C select {\n            width: 100%;\n            padding: 8px;\n            background: var(--vscode-input-background);\n            color: var(--vscode-input-foreground);\n            border: 1px solid var(--vscode-input-border);\n            border-radius: 4px;\n            font-family: inherit;\n            box-sizing: border-box;\n          }\n          textarea {\n            resize: vertical;\n            min-height: 80px;\n          }\n          .priority-selector {\n            display: flex;\n            gap: 8px;\n          }\n          .priority-btn {\n            padding: 8px 12px;\n            border: 2px solid transparent;\n            border-radius: 4px;\n            background: var(--vscode-button-background);\n            color: var(--vscode-button-foreground);\n            cursor: pointer;\n            font-weight: bold;\n          }\n          button {\n            padding: 8px 16px;\n            background: var(--vscode-button-background);\n            color: var(--vscode-button-foreground);\n            border: none;\n            border-radius: 4px;\n            cursor: pointer;\n            font-weight: bold;\n          }\n        </style>\n      </head>\n      <body>\n        <div class="container">\n          <h2>\ud83d\udccb Create Task</h2>\n          <div class="form-group">\n            <label>Task Name *</label>\n            <input type="text" id="taskName" placeholder="e.g: validateUserInput">\n          </div>\n          <div class="form-group">\n            <label>Priority</label>\n            <div class="priority-selector">\n              <button class="priority-btn" data-priority="P0">P0</button>\n              <button class="priority-btn" data-priority="P1">P1</button>\n              <button class="priority-btn" data-priority="P2">P2</button>\n              <button class="priority-btn" data-priority="P3">P3</button>\n            </div>\n          </div>\n          <div class="form-group">\n            <label>Description</label>\n            <textarea id="description" placeholder="Describe this task..."></textarea>\n          </div>\n          <div class="form-group">\n            <label>Dependencies</label>\n            <input type="text" id="dependencyInput" placeholder="Enter task name and press Enter">\n          </div>\n          <div style="display: flex; gap: 8px; margin-top: 16px;">\n            <button>\u2713 Create Task</button>\n            <button>\u21bb Reset</button>\n          </div>\n        </div>\n      </body>\n      </html>`;\n  }\n\n  handleWebviewMessage(message) {\n    switch (message.command) {\n      case 'createTask':\n        this.createTask(message.data);\n        break;\n      case 'updateTask':\n        this.updateTask(message.data);\n        break;\n      case 'deleteTask':\n        this.deleteTask(message.data);\n        break;\n    }\n  }\n\n  createTask(data) {\n    const taskId = 'task_' + Date.now();\n    const task = {\n      id: taskId\x2C\n      name: data.name\x2C\n      priority: data.priority\x2C\n      description: data.description\x2C\n      dependencies: data.dependencies || []\x2C\n      status: 'pending'\x2C\n      progress: 0\x2C\n      createdAt: new Date()\x2C\n      logs: []\x2C\n      executionHistory: []\x2C\n    };\n\n    if (this.hasCyclicDependency(task)) {\n      this.vscode.window.showErrorMessage('Cyclic dependency detected!');\n      return;\n    }\n\n    this._tasks.set(taskId\x2C task);\n    this.vscode.window.showInformationMessage(`\u2713 Task "${task.name}" created`);\n  }\n\n  hasCyclicDependency(task\x2C visited = new Set()) {\n    for (const depName of task.dependencies) {\n      if (visited.has(depName)) {\n        return true;\n      }\n      \n      visited.add(depName);\n      \n      for (const [\x2C t] of this._tasks) {\n        if (t.name === depName) {\n          if (this.hasCyclicDependency(t\x2C new Set(visited))) {\n            return true;\n          }\n          break;\n        }\n      }\n    }\n    \n    return false;\n  }\n\n  updateTask(data) {\n    const task = this._tasks.get(data.id);\n    if (!task) return;\n    \n    Object.assign(task\x2C data);\n    this.vscode.window.showInformationMessage('\u2713 Task updated');\n  }\n\n  deleteTask(taskId) {\n    this._tasks.delete(taskId);\n    this.vscode.window.showInformationMessage('\u2713 Task deleted');\n  }\n\n  getAllTasks() {\n    return Array.from(this._tasks.values());\n  }\n\n  exportTasks() {\n    const tasks = this.getAllTasks();\n    return JSON.stringify(tasks\x2C null\x2C 2);\n  }\n}\n\n/**\n * Benchmark 1: Webview HTML generation\n * Measures time to generate HTML form with N tasks listed\n * Expected: <200ms for typical 100-task form\n */\nasync function benchmarkHtmlGeneration() {\n  const monitor = new PerformanceMonitor();\n  const scales = [50\x2C 100\x2C 200];\n  \n  for (const scale of scales) {\n    const opName = `html-gen-${scale}`;\n    \n    // Run 5 iterations for statistical significance\n    for (let i = 0; i < 5; i++) {\n      const panel = new TaskManagementPanel(createMockVscode()\x2C createMockContext());\n      \n      monitor.start(opName);\n      // Generate HTML content - this is called when panel.show() is invoked\n      const html = panel.getWebviewContent();\n      monitor.end(opName);\n    }\n  }\n  \n  // Return aggregated results\n  const report = monitor.report('html-gen-100');\n  monitor.destroy();\n  \n  return {\n    name: 'Benchmark 1: Webview HTML Generation'\x2C\n    description: 'Generate HTML for task form'\x2C\n    target: '<200ms'\x2C\n    result: report.latency.p50\x2C\n    unit: 'ms'\x2C\n    passed: report.latency.p95 < 200\x2C\n    details: {\n      p50: report.latency.p50\x2C\n      p95: report.latency.p95\x2C\n      p99: report.latency.p99\x2C\n      iterations: report.iterations\n    }\n  };\n}\n\n/**\n * Benchmark 2: Form rendering (panel.show())\n * Measures time from show() to webview ready\n * Expected: \u2264400ms total\n */\nasync function benchmarkFormRendering() {\n  const monitor = new PerformanceMonitor();\n  \n  for (let i = 0; i < 10; i++) {\n    const panel = new TaskManagementPanel(createMockVscode()\x2C createMockContext());\n    \n    monitor.start('form-render');\n    // Simulate show() which creates webview and generates HTML\n    await panel.show();\n    monitor.end('form-render');\n  }\n  \n  const report = monitor.report('form-render');\n  monitor.destroy();\n  \n  return {\n    name: 'Benchmark 2: Form Rendering (panel.show())'\x2C\n    description: 'Time from show() to webview ready'\x2C\n    target: '\u2264400ms'\x2C\n    result: report.latency.p50\x2C\n    unit: 'ms'\x2C\n    passed: report.latency.p95 <= 400\x2C\n    details: {\n      p50: report.latency.p50\x2C\n      p95: report.latency.p95\x2C\n      p99: report.latency.p99\x2C\n      iterations: report.iterations\n    }\n  };\n}\n\n/**\n * Benchmark 3: Cyclic dependency detection (DFS)\n * Creates task with M dependencies and runs cyclic detection\n * Expected: \u226410ms for 100 dependencies\n */\nasync function benchmarkCyclicDetection() {\n  const monitor = new PerformanceMonitor();\n  const depCounts = [10\x2C 50\x2C 100];\n  \n  for (const depCount of depCounts) {\n    const opName = `cyclic-detect-${depCount}`;\n    \n    for (let iter = 0; iter < 5; iter++) {\n      const panel = new TaskManagementPanel(createMockVscode()\x2C createMockContext());\n      \n      // Create tasks with dependencies\n      const tasks = generateTasks(depCount + 10\x2C 42 + iter);\n      \n      // Add tasks to panel\n      for (const task of tasks) {\n        panel._tasks.set(task.id\x2C {\n          id: task.id\x2C\n          name: task.name\x2C\n          dependencies: task.dependencies.map(d => `task-${d}`)\x2C\n          priority: task.priority\x2C\n          status: task.status\x2C\n          progress: task.progress\n        });\n      }\n      \n      // Measure cyclic detection\n      const testTask = panel._tasks.get('task-0');\n      \n      monitor.start(opName);\n      const hasCycle = panel.hasCyclicDependency(testTask);\n      monitor.end(opName);\n    }\n  }\n  \n  const report = monitor.report('cyclic-detect-100');\n  monitor.destroy();\n  \n  return {\n    name: 'Benchmark 3: Cyclic Dependency Detection (DFS)'\x2C\n    description: 'Time to detect cycle or confirm no cycle'\x2C\n    target: '\u226410ms'\x2C\n    result: report.latency.p50\x2C\n    unit: 'ms'\x2C\n    passed: report.latency.p95 <= 10\x2C\n    details: {\n      p50: report.latency.p50\x2C\n      p95: report.latency.p95\x2C\n      p99: report.latency.p99\x2C\n      iterations: report.iterations\n    }\n  };\n}\n\n/**\n * Benchmark 4: Form validation on input\n * Simulates form input changes and validation\n * Expected: \u226450ms per validation\n */\nasync function benchmarkFormValidation() {\n  const monitor = new PerformanceMonitor();\n  \n  // Test various validation scenarios\n  const validationTests = [\n    { name: ''\x2C priority: 'P0'\x2C description: '' }\x2C // Invalid: empty name\n    { name: 'ValidTask'\x2C priority: 'P1'\x2C description: 'A valid task' }\x2C\n    { name: 'TaskWithDeps'\x2C priority: 'P0'\x2C description: ''\x2C dependencies: ['dep1'\x2C 'dep2'] }\x2C\n  ];\n  \n  for (let i = 0; i < 10; i++) {\n    const panel = new TaskManagementPanel(createMockVscode()\x2C createMockContext());\n    \n    for (const test of validationTests) {\n      monitor.start('validation');\n      \n      // Perform validation: check task name\x2C priority\x2C dependencies\n      let isValid = true;\n      \n      // Name validation\n      if (!test.name || test.name.trim().length === 0) {\n        isValid = false;\n      }\n      \n      // Priority validation\n      const validPriorities = ['P0'\x2C 'P1'\x2C 'P2'\x2C 'P3'];\n      if (!validPriorities.includes(test.priority)) {\n        isValid = false;\n      }\n      \n      // Dependencies check (would be checked for cycles)\n      if (test.dependencies && test.dependencies.length > 0) {\n        // Simulate cyclic dependency check\n        const testTask = {\n          id: 'test'\x2C\n          name: test.name\x2C\n          dependencies: test.dependencies\x2C\n          priority: test.priority\n        };\n        \n        // Add some mock tasks to check against\n        panel._tasks.set('dep1'\x2C { id: 'dep1'\x2C name: 'dep1'\x2C dependencies: [] });\n        panel._tasks.set('dep2'\x2C { id: 'dep2'\x2C name: 'dep2'\x2C dependencies: [] });\n        \n        // This would check for cycles\n        const hasCycle = panel.hasCyclicDependency(testTask);\n        if (hasCycle) {\n          isValid = false;\n        }\n      }\n      \n      monitor.end('validation');\n    }\n  }\n  \n  const report = monitor.report('validation');\n  monitor.destroy();\n  \n  return {\n    name: 'Benchmark 4: Form Validation on Input'\x2C\n    description: 'Validation latency per keystroke/field change'\x2C\n    target: '\u226450ms'\x2C\n    result: report.latency.p50\x2C\n    unit: 'ms'\x2C\n    passed: report.latency.p95 <= 50\x2C\n    details: {\n      p50: report.latency.p50\x2C\n      p95: report.latency.p95\x2C\n      p99: report.latency.p99\x2C\n      iterations: report.iterations\x2C\n      validationTestCount: 3\n    }\n  };\n}\n\n/**\n * Benchmark 5: Webview memory consumption\n * Loads webview panel with form and measures memory usage\n * Expected: \u226420MB for panel\n */\nasync function benchmarkMemoryConsumption() {\n  const monitor = new PerformanceMonitor();\n  \n  // Measure memory before and after loading panels\n  for (let i = 0; i < 5; i++) {\n    const panel = new TaskManagementPanel(createMockVscode()\x2C createMockContext());\n    \n    monitor.start('memory-webview');\n    \n    // Create and show panel (this allocates memory for HTML\x2C event handlers\x2C etc.)\n    await panel.show();\n    \n    // Add some tasks to simulate realistic usage\n    for (let j = 0; j < 50; j++) {\n      panel.createTask({\n        name: `Task ${j}`\x2C\n        priority: ['P0'\x2C 'P1'\x2C 'P2'\x2C 'P3'][j % 4]\x2C\n        description: `Task description ${j}`\x2C\n        dependencies: []\n      });\n    }\n    \n    monitor.end('memory-webview');\n  }\n  \n  const report = monitor.report('memory-webview');\n  \n  // Memory is reported in bytes\x2C convert to MB for readability\n  const heapUsedMB = Math.abs(report.memoryDelta.heapUsed) / (1024 * 1024);\n  \n  monitor.destroy();\n  \n  return {\n    name: 'Benchmark 5: Webview Memory Consumption'\x2C\n    description: 'Memory usage of webview panel + assets'\x2C\n    target: '\u226420MB'\x2C\n    result: heapUsedMB\x2C\n    unit: 'MB'\x2C\n    passed: heapUsedMB <= 20\x2C\n    details: {\n      heapUsedMB: heapUsedMB\x2C\n      heapUsedBytes: report.memoryDelta.heapUsed\x2C\n      p50: heapUsedMB\x2C\n      p95: heapUsedMB\x2C\n      iterations: report.iterations\n    }\n  };\n}\n\n/**\n * Run all benchmarks\n */\nasync function runTaskPanelBenchmarks() {\n  console.log('\ud83d\ude80 Starting Task Management Panel Benchmarks...\\n');\n  \n  const results = [];\n  \n  try {\n    // Run each benchmark\n    results.push(await benchmarkHtmlGeneration());\n    console.log(`\u2713 ${results[0].name} - ${results[0].result.toFixed(2)}${results[0].unit}`);\n    \n    results.push(await benchmarkFormRendering());\n    console.log(`\u2713 ${results[1].name} - ${results[1].result.toFixed(2)}${results[1].unit}`);\n    \n    results.push(await benchmarkCyclicDetection());\n    console.log(`\u2713 ${results[2].name} - ${results[2].result.toFixed(2)}${results[2].unit}`);\n    \n    results.push(await benchmarkFormValidation());\n    console.log(`\u2713 ${results[3].name} - ${results[3].result.toFixed(2)}${results[3].unit}`);\n    \n    results.push(await benchmarkMemoryConsumption());\n    console.log(`\u2713 ${results[4].name} - ${results[4].result.toFixed(2)}${results[4].unit}`);\n    \n  } catch (error) {\n    console.error('\u274c Benchmark error:'\x2C error);\n    throw error;\n  }\n  \n  // Print summary\n  console.log('\\n\ud83d\udcca Benchmark Summary:');\n  console.log('='.repeat(70));\n  \n  for (const result of results) {\n    const status = result.passed ? '\u2713 PASS' : '\u2717 FAIL';\n    console.log(`${status} | ${result.name}`);\n    console.log(`     Target: ${result.target} | Result: ${result.result.toFixed(2)}${result.unit}`);\n    console.log(`     P50: ${result.details.p50.toFixed(2)}${result.unit} | P95: ${result.details.p95.toFixed(2)}${result.unit}`);\n  }\n  \n  console.log('='.repeat(70));\n  \n  // Count passes\n  const passCount = results.filter(r => r.passed).length;\n  console.log(`\\n\u2713 ${passCount}/${results.length} benchmarks passed\\n`);\n  \n  // Return aggregated result\n  const allPassed = results.every(r => r.passed);\n  return {\n    name: 'Task Management Panel: Form & Validation Performance'\x2C\n    passed: allPassed\x2C\n    results: results\x2C\n    passCount: passCount\x2C\n    totalCount: results.length\n  };\n}\n\nmodule.exports = {\n  name: 'Task Management Panel: Form & Validation Performance'\x2C\n  run: runTaskPanelBenchmarks\n};\n
