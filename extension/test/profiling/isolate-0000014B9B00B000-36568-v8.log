code-creation,Eval,9,221056,0xd542bd86e0,5, C:\\Users\\asus\\Documents\\Codex\\2026-10-06\\new-chat\\outputs\\intentlens\\extension\\test\\fixtures\\task-fixtures.js:1:1,0xd39e523180,~
script-source,116,C:\\Users\\asus\\Documents\\Codex\\2026-10-06\\new-chat\\outputs\\intentlens\\extension\\test\\fixtures\\task-fixtures.js,/**\n * Task Fixtures - Generate deterministic test task data\n */\n\n/**\n * Simple seeded random number generator for reproducibility\n * @param {number} seed - Seed value\n * @returns {() => number} Function that returns pseudo-random numbers [0\x2C 1)\n */\nfunction createSeededRandom(seed) {\n  let value = seed;\n  return () => {\n    value = (value * 9301 + 49297) % 233280;\n    return value / 233280;\n  };\n}\n\n/**\n * Generate deterministic task objects\n * @param {number} count - Number of tasks to generate\n * @param {number} [seed=42] - Seed for reproducibility\n * @returns {Object[]} Array of task objects\n */\nfunction generateTasks(count\x2C seed = 42) {\n  const random = createSeededRandom(seed);\n  const priorities = ['P0'\x2C 'P1'\x2C 'P2'\x2C 'P3'];\n  const statuses = ['pending'\x2C 'in_progress'\x2C 'blocked'\x2C 'completed'];\n  const tasks = [];\n\n  for (let i = 0; i < count; i++) {\n    const priorityIndex = Math.floor(random() * priorities.length);\n    const statusIndex = Math.floor(random() * statuses.length);\n    const depCount = Math.floor(random() * 3); // 0-2 dependencies\n\n    const dependencies = [];\n    for (let d = 0; d < depCount; d++) {\n      const depId = Math.floor(random() * Math.max(1\x2C i));\n      if (depId !== i && !dependencies.includes(depId)) {\n        dependencies.push(depId);\n      }\n    }\n\n    tasks.push({\n      id: `task-${i}`\x2C\n      name: `Task ${i}`\x2C\n      priority: priorities[priorityIndex]\x2C\n      status: statuses[statusIndex]\x2C\n      progress: Math.floor(random() * 101)\x2C // 0-100\n      dependencies: dependencies\n    });\n  }\n\n  return tasks;\n}\n\nmodule.exports = {\n  generateTasks\x2C\n  createSeededRandom\n};\n
