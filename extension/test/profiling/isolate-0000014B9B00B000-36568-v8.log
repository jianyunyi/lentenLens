script-source,117,C:\\Users\\asus\\Documents\\Codex\\2026-10-06\\new-chat\\outputs\\intentlens\\extension\\test\\fixtures\\api-mocks.js,/**\n * API Mocks - Mock VS Code API objects for testing\n */\n\n/**\n * Create a mock TextEditor object\n * @returns {Object} Mock TextEditor\n */\nfunction createMockTextEditor() {\n  return {\n    document: {\n      uri: { fsPath: '/mock/file.go' }\x2C\n      languageId: 'go'\x2C\n      isDirty: false\x2C\n      isClosed: false\x2C\n      lineCount: 100\x2C\n      getText: () => 'package main\\n\\nfunc main() {}'\x2C\n      getWordRangeAtPosition: () => null\x2C\n      lineAt: (line) => ({\n        text: `line ${line}`\x2C\n        range: { start: { line }\x2C end: { line\x2C character: 10 } }\n      })\n    }\x2C\n    selection: {\n      start: { line: 0\x2C character: 0 }\x2C\n      end: { line: 0\x2C character: 10 }\x2C\n      anchor: { line: 0\x2C character: 0 }\x2C\n      active: { line: 0\x2C character: 10 }\x2C\n      isEmpty: false\x2C\n      isSingleLine: true\x2C\n      isReversed: false\n    }\x2C\n    visibleRanges: [\n      {\n        start: { line: 0\x2C character: 0 }\x2C\n        end: { line: 50\x2C character: 0 }\n      }\n    ]\x2C\n    viewColumn: 1\x2C\n    options: {\n      tabSize: 4\x2C\n      insertSpaces: true\n    }\n  };\n}\n\n/**\n * Create a mock ExtensionContext object\n * @returns {Object} Mock ExtensionContext\n */\nfunction createMockExtensionContext() {\n  const subscriptions = [];\n  \n  return {\n    subscriptions\x2C\n    workspaceState: createMockMemento()\x2C\n    globalState: createMockMemento()\x2C\n    secrets: createMockSecrets()\x2C\n    extensionUri: { fsPath: '/mock/extension' }\x2C\n    extensionPath: '/mock/extension'\x2C\n    environmentVariableCollection: createMockEnvironmentVariableCollection()\x2C\n    storageUri: { fsPath: '/mock/storage' }\x2C\n    storagePath: '/mock/storage'\x2C\n    globalStorageUri: { fsPath: '/mock/global-storage' }\x2C\n    globalStoragePath: '/mock/global-storage'\x2C\n    logUri: { fsPath: '/mock/logs' }\x2C\n    logPath: '/mock/logs'\x2C\n    asAbsolutePath: (relativePath) => `/mock/extension/${relativePath}`\x2C\n    extension: {\n      id: 'mock-extension'\x2C\n      packageJSON: {}\x2C\n      isActive: true\x2C\n      activate: async () => ({})\n    }\n  };\n}\n\n/**\n * Create a mock Memento object (for workspace/global state)\n * @returns {Object} Mock Memento\n */\nfunction createMockMemento() {\n  const storage = new Map();\n\n  return {\n    keys: () => Array.from(storage.keys())\x2C\n    get: (key\x2C defaultValue) => storage.has(key) ? storage.get(key) : defaultValue\x2C\n    update: async (key\x2C value) => {\n      if (value === undefined) {\n        storage.delete(key);\n      } else {\n        storage.set(key\x2C value);\n      }\n    }\n  };\n}\n\n/**\n * Create a mock Secrets object\n * @returns {Object} Mock Secrets\n */\nfunction createMockSecrets() {\n  const secrets = new Map();\n\n  return {\n    get: async (key) => secrets.get(key) || null\x2C\n    store: async (key\x2C value) => secrets.set(key\x2C value)\x2C\n    delete: async (key) => secrets.delete(key)\x2C\n    onDidChange: {\n      _listeners: []\x2C\n      fire: function(key) {\n        this._listeners.forEach(cb => cb({ key }));\n      }\x2C\n      subscribe: function(listener) {\n        this._listeners.push(listener);\n        return { dispose: () => {\n          const idx = this._listeners.indexOf(listener);\n          if (idx !== -1) this._listeners.splice(idx\x2C 1);\n        }};\n      }\n    }\n  };\n}\n\n/**\n * Create a mock EnvironmentVariableCollection object\n * @returns {Object} Mock EnvironmentVariableCollection\n */\nfunction createMockEnvironmentVariableCollection() {\n  const vars = new Map();\n\n  return {\n    replace: (variable\x2C value) => vars.set(variable\x2C { value\x2C operation: 'replace' })\x2C\n    append: (variable\x2C value) => vars.set(variable\x2C { value\x2C operation: 'append' })\x2C\n    prepend: (variable\x2C value) => vars.set(variable\x2C { value\x2C operation: 'prepend' })\x2C\n    get: (variable) => vars.get(variable)\x2C\n    forEach: (callback) => vars.forEach((val\x2C key) => callback(key\x2C val))\x2C\n    delete: (variable) => vars.delete(variable)\x2C\n    clear: () => vars.clear()\n  };\n}\n\n/**\n * Create mock commands API\n * @returns {Object} Mock commands API\n */\nfunction createMockCommandsAPI() {\n  const commands = new Map();\n\n  return {\n    registerCommand: (commandId\x2C callback) => {\n      commands.set(commandId\x2C callback);\n      return { dispose: () => commands.delete(commandId) };\n    }\x2C\n    executeCommand: async (commandId\x2C ...args) => {\n      const command = commands.get(commandId);\n      if (!command) {\n        throw new Error(`Command '${commandId}' not found`);\n      }\n      return await command(...args);\n    }\x2C\n    getCommands: async () => Array.from(commands.keys())\n  };\n}\n\nmodule.exports = {\n  createMockTextEditor\x2C\n  createMockExtensionContext\x2C\n  createMockMemento\x2C\n  createMockSecrets\x2C\n  createMockEnvironmentVariableCollection\x2C\n  createMockCommandsAPI\n};\n
