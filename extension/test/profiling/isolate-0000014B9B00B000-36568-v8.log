code-creation,Eval,9,236957,0xd542bda6a8,5, C:\\Users\\asus\\Documents\\Codex\\2026-10-06\\new-chat\\outputs\\intentlens\\extension\\test\\benchmarks\\task-panel-bench.js:1:1,0xd39e52f688,~
script-source,121,C:\\Users\\asus\\Documents\\Codex\\2026-10-06\\new-chat\\outputs\\intentlens\\extension\\test\\benchmarks\\task-panel-bench.js,/**\n * Task Panel Benchmarks - Performance testing for TaskTreeProvider\n * \n * Benchmarks:\n * 1. TaskTreeProvider Initialization - time to instantiate and initialize with N tasks\n * 2. getChildren() root expansion - time to fetch all tasks at root\n * 3. applyFilter() performance - filter 10k tasks with predicate\n * 4. applySortBy() performance - sort tasks by criteria\n * 5. Memory consumption - track memory delta for task loading\n */\n\nconst PerformanceMonitor = require('../profiling/PerformanceMonitor');\nconst { generateTasks } = require('../fixtures/task-fixtures');\n\n/**\n * Minimal TaskTreeProvider mock for benchmarking\n * Provides core functionality needed for performance testing\n */\nclass TaskTreeProvider {\n  constructor(vscode) {\n    this.vscode = vscode;\n    this._tasks = [];\n    this._filter = { status: []\x2C priority: []\x2C searchText: '' };\n    this._expandedItems = new Set();\n  }\n\n  setTasks(tasks) {\n    this._tasks = tasks;\n  }\n\n  getChildren(element) {\n    if (!element) {\n      // Root: return filtered tasks\n      return this.getFilteredTasks().map(task => ({\n        task\x2C\n        _isTaskItem: true\x2C\n      }));\n    }\n    return [];\n  }\n\n  getFilteredTasks() {\n    return this._tasks.filter(task => {\n      // Filter by priority\n      if (this._filter.priority.length > 0 && \n          !this._filter.priority.includes(task.priority)) {\n        return false;\n      }\n\n      // Filter by status\n      if (this._filter.status.length > 0 && \n          !this._filter.status.includes(task.status)) {\n        return false;\n      }\n\n      // Filter by search text\n      if (this._filter.searchText) {\n        const searchLower = this._filter.searchText.toLowerCase();\n        const matches = \n          task.name.toLowerCase().includes(searchLower) ||\n          task.description?.toLowerCase().includes(searchLower);\n        if (!matches) return false;\n      }\n\n      return true;\n    });\n  }\n\n  setFilter(filter) {\n    this._filter = { ...this._filter\x2C ...filter };\n  }\n}\n\n/**\n * Mock vscode object for TaskTreeProvider\n */\nfunction createMockVscode() {\n  return {\n    TreeItemCollapsibleState: {\n      None: 0\x2C\n      Collapsed: 1\x2C\n      Expanded: 2\x2C\n    }\x2C\n    ThemeIcon: function(name) {\n      this.id = name;\n    }\x2C\n    MarkdownString: function(str) {\n      this.value = str;\n    }\x2C\n    EventEmitter: function() {\n      this.listeners = [];\n      this.event = null;\n      this.fire = function(data) {\n        this.listeners.forEach(cb => cb(data));\n      };\n      this.on = function(cb) {\n        this.listeners.push(cb);\n      };\n    }\x2C\n  };\n}\n\n/**\n * Benchmark 1: TaskTreeProvider Initialization\n * Measures time to instantiate and initialize with N tasks\n * Expected: <500ms for 10k tasks\n */\nasync function benchInitialization() {\n  const monitor = new PerformanceMonitor();\n  const scales = [1000\x2C 5000\x2C 10000\x2C 50000];\n  const vscode = createMockVscode();\n  \n  for (const scale of scales) {\n    const opName = `init-${scale}`;\n    \n    // Run 10 iterations per scale for stable percentiles\n    for (let i = 0; i < 10; i++) {\n      monitor.start(opName);\n      \n      // Generate tasks\n      const tasks = generateTasks(scale\x2C 42 + i);\n      \n      // Create provider and set tasks\n      const provider = new TaskTreeProvider(vscode);\n      provider.setTasks(tasks);\n      \n      monitor.end(opName);\n    }\n  }\n  \n  // Aggregate results\n  const report10k = monitor.report('init-10000');\n  \n  return {\n    name: 'Benchmark 1: TaskTreeProvider Initialization'\x2C\n    scales: {\n      '1k': monitor.report('init-1000')\x2C\n      '5k': monitor.report('init-5000')\x2C\n      '10k': report10k\x2C\n      '50k': monitor.report('init-50000')\x2C\n    }\x2C\n    aggregated: {\n      latency: report10k.latency\x2C\n      iterations: report10k.iterations\x2C\n      memoryDelta: report10k.memoryDelta\x2C\n      gcCount: report10k.gcCount\x2C\n      gcTotalTime: report10k.gcTotalTime\x2C\n      status: report10k.latency.p95 < 500 ? 'PASS' : 'FAIL'\x2C\n      threshold: '< 500ms (p95)'\x2C\n    }\n  };\n}\n\n/**\n * Benchmark 2: getChildren() root expansion\n * Measures time to fetch all tasks at root level\n * Expected: proportional to task count\n */\nasync function benchGetChildren() {\n  const monitor = new PerformanceMonitor();\n  const scales = [1000\x2C 5000\x2C 10000\x2C 50000];\n  const vscode = createMockVscode();\n  \n  for (const scale of scales) {\n    const opName = `getChildren-${scale}`;\n    const tasks = generateTasks(scale\x2C 42);\n    const provider = new TaskTreeProvider(vscode);\n    provider.setTasks(tasks);\n    \n    // Run 10 iterations per scale\n    for (let i = 0; i < 10; i++) {\n      monitor.start(opName);\n      \n      // Call getChildren at root (returns all tasks)\n      const children = provider.getChildren(undefined);\n      \n      monitor.end(opName);\n    }\n  }\n  \n  // Aggregate results\n  const report10k = monitor.report('getChildren-10000');\n  \n  return {\n    name: 'Benchmark 2: getChildren() Root Expansion'\x2C\n    scales: {\n      '1k': monitor.report('getChildren-1000')\x2C\n      '5k': monitor.report('getChildren-5000')\x2C\n      '10k': report10k\x2C\n      '50k': monitor.report('getChildren-50000')\x2C\n    }\x2C\n    aggregated: {\n      latency: report10k.latency\x2C\n      iterations: report10k.iterations\x2C\n      memoryDelta: report10k.memoryDelta\x2C\n      gcCount: report10k.gcCount\x2C\n      gcTotalTime: report10k.gcTotalTime\x2C\n      status: 'PASS'\x2C\n      note: 'Time should be proportional to task count'\x2C\n    }\n  };\n}\n\n/**\n * Benchmark 3: applyFilter() performance\n * Filters 10k tasks with priority predicate (P0 only)\n * Expected: \u2264100ms\n */\nasync function benchFilter() {\n  const monitor = new PerformanceMonitor();\n  const vscode = createMockVscode();\n  const tasks = generateTasks(10000\x2C 42);\n  const provider = new TaskTreeProvider(vscode);\n  provider.setTasks(tasks);\n  \n  const opName = 'filter-10k-p0';\n  \n  // Run 10 iterations for stable percentiles\n  for (let i = 0; i < 10; i++) {\n    monitor.start(opName);\n    \n    // Apply priority filter (P0 only)\n    provider.setFilter({ priority: ['P0'] });\n    const filtered = provider.getFilteredTasks();\n    \n    monitor.end(opName);\n  }\n  \n  const report = monitor.report(opName);\n  \n  return {\n    name: 'Benchmark 3: applyFilter() Performance'\x2C\n    filter: 'priority === "P0"'\x2C\n    taskCount: 10000\x2C\n    aggregated: {\n      latency: report.latency\x2C\n      iterations: report.iterations\x2C\n      memoryDelta: report.memoryDelta\x2C\n      gcCount: report.gcCount\x2C\n      gcTotalTime: report.gcTotalTime\x2C\n      status: report.latency.p95 <= 100 ? 'PASS' : 'WARN'\x2C\n      threshold: '\u2264 100ms (p95)'\x2C\n    }\n  };\n}\n\n/**\n * Benchmark 4: applySortBy() performance with filter combined\n * Sorts 10k tasks by executionTime (descending) after filtering\n * Expected: \u2264100ms combined with filter\n */\nasync function benchSort() {\n  const monitor = new PerformanceMonitor();\n  const vscode = createMockVscode();\n  \n  // Generate tasks with execution times\n  const tasks = generateTasks(10000\x2C 42).map((task\x2C idx) => ({\n    ...task\x2C\n    executionTime: Math.floor(Math.random() * 5000)\x2C // 0-5000ms\n  }));\n  \n  const provider = new TaskTreeProvider(vscode);\n  provider.setTasks(tasks);\n  \n  const opName = 'sort-10k-executionTime';\n  \n  // Run 10 iterations\n  for (let i = 0; i < 10; i++) {\n    monitor.start(opName);\n    \n    // Get filtered tasks and sort\n    let sorted = provider.getFilteredTasks();\n    sorted = sorted.sort((a\x2C b) => (b.executionTime || 0) - (a.executionTime || 0));\n    \n    monitor.end(opName);\n  }\n  \n  const report = monitor.report(opName);\n  \n  return {\n    name: 'Benchmark 4: applySortBy() Performance'\x2C\n    sortBy: 'executionTime (descending)'\x2C\n    taskCount: 10000\x2C\n    aggregated: {\n      latency: report.latency\x2C\n      iterations: report.iterations\x2C\n      memoryDelta: report.memoryDelta\x2C\n      gcCount: report.gcCount\x2C\n      gcTotalTime: report.gcTotalTime\x2C\n      status: report.latency.p95 <= 100 ? 'PASS' : 'WARN'\x2C\n      threshold: '\u2264 100ms (p95)'\x2C\n    }\n  };\n}\n\n/**\n * Benchmark 5: Memory consumption\n * Tracks memory delta when loading N tasks\n * Expected: \u2264150MB for 10k tasks\n */\nasync function benchMemory() {\n  const monitor = new PerformanceMonitor();\n  const scales = [1000\x2C 5000\x2C 10000\x2C 50000];\n  const vscode = createMockVscode();\n  \n  // Force GC before starting (if possible)\n  if (global.gc) {\n    global.gc();\n  }\n  \n  for (const scale of scales) {\n    const opName = `memory-${scale}`;\n    \n    // Run 5 iterations (fewer to focus on memory)\n    for (let i = 0; i < 5; i++) {\n      monitor.start(opName);\n      \n      // Generate and load tasks\n      const tasks = generateTasks(scale\x2C 42 + i);\n      const provider = new TaskTreeProvider(vscode);\n      provider.setTasks(tasks);\n      provider.getChildren(undefined);\n      \n      monitor.end(opName);\n    }\n  }\n  \n  // Aggregate results\n  const report10k = monitor.report('memory-10000');\n  const heapUsedMB = report10k.memoryDelta.heapUsed / (1024 * 1024);\n  \n  return {\n    name: 'Benchmark 5: Memory Consumption'\x2C\n    scales: {\n      '1k': {\n        heapUsedMB: (monitor.report('memory-1000').memoryDelta.heapUsed / (1024 * 1024)).toFixed(2)\x2C\n      }\x2C\n      '5k': {\n        heapUsedMB: (monitor.report('memory-5000').memoryDelta.heapUsed / (1024 * 1024)).toFixed(2)\x2C\n      }\x2C\n      '10k': {\n        heapUsedMB: heapUsedMB.toFixed(2)\x2C\n      }\x2C\n      '50k': {\n        heapUsedMB: (monitor.report('memory-50000').memoryDelta.heapUsed / (1024 * 1024)).toFixed(2)\x2C\n      }\x2C\n    }\x2C\n    aggregated: {\n      latency: report10k.latency\x2C\n      memoryDelta: report10k.memoryDelta\x2C\n      iterations: report10k.iterations\x2C\n      heapUsedMB: heapUsedMB.toFixed(2)\x2C\n      status: heapUsedMB <= 150 ? 'PASS' : 'WARN'\x2C\n      threshold: '\u2264 150MB (10k tasks)'\x2C\n    }\n  };\n}\n\n/**\n * Run all TaskTreeProvider benchmarks\n */\nasync function runTaskPanelBench() {\n  const results = [];\n  \n  // Run each benchmark\n  const bench1 = await benchInitialization();\n  results.push(bench1);\n  \n  const bench2 = await benchGetChildren();\n  results.push(bench2);\n  \n  const bench3 = await benchFilter();\n  results.push(bench3);\n  \n  const bench4 = await benchSort();\n  results.push(bench4);\n  \n  const bench5 = await benchMemory();\n  results.push(bench5);\n  \n  // Aggregate summary\n  const summary = {\n    name: 'Task Panel: Initialize & Filter/Sort Performance'\x2C\n    benchmarks: results\x2C\n    status: results.every(b => b.aggregated?.status === 'PASS' || b.aggregated?.status === 'WARN') ? 'PASS' : 'FAIL'\x2C\n  };\n  \n  return summary;\n}\n\nmodule.exports = {\n  name: 'Task Panel: Initialize & Filter/Sort Performance'\x2C\n  run: runTaskPanelBench\x2C\n};\n
