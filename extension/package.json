{
  "name": "intentlens",
  "displayName": "IntentLens",
  "description": "Go function explanations tied to local source evidence and Claude Code round snapshots.",
  "version": "0.1.0",
  "publisher": "intentlens-local",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./src/extension.js",
  "activationEvents": ["onLanguage:go", "onView:intentlens.rounds"],
  "capabilities": { "untrustedWorkspaces": { "supported": "limited", "description": "Views are available; CLI execution requires workspace trust." }, "virtualWorkspaces": { "supported": false } },
  "scripts": { "test": "node --test test/*.test.js", "check": "node --check src/core.js && node --check src/extension.js" },
  "contributes": {
    "commands": [
      { "command": "intentlens.inspect", "title": "IntentLens: 查看当前函数解释与证据" },
      { "command": "intentlens.refresh", "title": "IntentLens: 刷新轮次与 CodeLens" },
      { "command": "intentlens.status", "title": "IntentLens: 查看状态与预算" },
      { "command": "intentlens.enableModel", "title": "IntentLens: 启用或调整模型分析" },
      { "command": "intentlens.pauseModel", "title": "IntentLens: 暂停模型分析" },
      { "command": "intentlens.hooksConfig", "title": "IntentLens: 预览 Claude Code Hook 配置" }
    ],
    "views": { "explorer": [{ "id": "intentlens.rounds", "name": "IntentLens · 轮次" }] },
    "viewsWelcome": [{ "view": "intentlens.rounds", "contents": "打开并信任本地 Go 工作区。轮次由 Claude Code hooks 记录。\n[预览 Hook 配置](command:intentlens.hooksConfig)\n[刷新](command:intentlens.refresh)" }],
    "menus": { "view/title": [{ "command": "intentlens.refresh", "when": "view == intentlens.rounds", "group": "navigation" }] },
    "configuration": { "title": "IntentLens", "properties": { "intentlens.binaryPath": { "type": "string", "default": "", "scope": "machine-overridable", "restricted": true, "description": "IntentLens executable path. Empty uses bundled bin/intentlens(.exe), then PATH. No shell arguments." } } }
  }
}
