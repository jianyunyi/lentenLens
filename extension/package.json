{
    "name":  "intentlens",
    "displayName":  "IntentLens",
    "description":  "Go explanations tied to local source evidence, plus selected-code explanations.",
    "version":  "0.7.1",
    "publisher":  "lentenlens",
    "license":  "MIT",
    "author":  {
                   "name":  "IntentLens Contributors",
                   "email":  "16671100373@163.com"
               },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/jianyunyi/lentenLens.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/jianyunyi/lentenLens/issues",
                 "email":  "16671100373@163.com"
             },
    "homepage":  "https://github.com/jianyunyi/lentenLens#readme",
    "keywords":  [
                     "go",
                     "golang",
                     "ai",
                     "code-analysis",
                     "code-understanding",
                     "documentation",
                     "explanations",
                     "llm",
                     "code-review"
                 ],
    "engines":  {
                    "vscode":  "^1.90.0"
                },
    "categories":  [
                       "Programming Languages",
                       "Machine Learning",
                       "Other"
                   ],
    "icon":  "icon.png",
    "extensionKind":  [
                          "workspace"
                      ],
    "main":  "./src/extension.js",
    "activationEvents":  [
                             "onLanguage:go",
                             "onView:intentlens.rounds",
                             "onView:intentlens.callPath",
                             "onView:intentlens.modelAnswer",
                             "onCommand:intentlens.callPath",
                             "onCommand:intentlens.refreshCallPath",
                             "onCommand:intentlens.refreshModelAnswer",
                             "onCommand:intentlens.enableModel",
                             "onCommand:intentlens.testModel",
                             "onCommand:intentlens.explainSelection",
                             "onCommand:intentlens.configureAPI",
                             "onCommand:intentlens.viewTokenUsage",
                             "onView:intentlens.restrictions"
                         ],
    "capabilities":  {
                         "untrustedWorkspaces":  {
                                                     "supported":  "limited",
                                                     "description":  "Views are available; CLI execution requires workspace trust."
                                                 },
                         "virtualWorkspaces":  {
                                                   "supported":  false
                                               }
                     },
    "scripts":  {
                    "test":  "node --test test/*.test.js",
                    "test:coverage":  "c8 --all --src src --include \"src/**/*.js\" --reporter=text --reporter=lcov --report-dir coverage --check-coverage --lines 85 --functions 86 --branches 75 node --test test/*.test.js",
                    "test:integration":  "node ../scripts/run-vscode-integration.cjs",
                    "check":  "node --check src/aiConfigPanel.js && node --check src/callpath.js && node --check src/core.js && node --check src/coverage.js && node --check src/exercises.js && node --check src/extension.js && node --check src/inline.js && node --check src/log.js && node --check src/providers.js && node --check src/recovery.js && node --check src/restrictionDetailPanel.js && node --check src/restrictionView.js && node --check src/sessions.js && node --check src/sidebar.js && node --check src/tokenUsagePanel.js"
                },
    "devDependencies":  {
                            "c8":  "10.1.3",
                            "@vscode/test-electron":  "2.5.2"
                        },
    "contributes":  {
                        "commands":  [
                                         {
                                             "command":  "intentlens.exercises",
                                             "title":  "IntentLens: 查看本地练习"
                                         },
                                         {
                                             "command":  "intentlens.sharedExercises",
                                             "title":  "IntentLens: 查看团队共享题目"
                                         },
                                         {
                                             "command":  "intentlens.shared",
                                             "title":  "IntentLens: 查看团队共享解释"
                                         },
                                         {
                                             "command":  "intentlens.inspect",
                                             "title":  "IntentLens: 查看当前函数解释与证据"
                                         },
                                         {
                                             "command":  "intentlens.inspectDetails",
                                             "title":  "IntentLens: 打开函数完整详情与历史"
                                         },
                                         {
                                             "command":  "intentlens.explainSelection",
                                             "title":  "IntentLens: 解释选中代码（作用、流程与设计考虑）",
                                             "description":  "文件相对路径仅用于本机排除规则检查；模型仅收到所选代码、语言、坐标及选区内错误，不收到路径或项目上下文"
                                         },
                                         {
                                             "command":  "intentlens.callPath",
                                             "title":  "IntentLens: 显示调用路径"
                                         },
                                         {
                                             "command":  "intentlens.refreshCallPath",
                                             "title":  "IntentLens: 刷新调用路径",
                                             "icon":  "$(refresh)"
                                         },
                                         {
                                             "command":  "intentlens.refreshModelAnswer",
                                             "title":  "IntentLens: 刷新模型回答与证据",
                                             "icon":  "$(refresh)"
                                         },
                                         {
                                             "command":  "intentlens.refresh",
                                             "title":  "IntentLens: 刷新轮次与 CodeLens"
                                         },
                                         {
                                             "command":  "intentlens.indexStatus",
                                             "title":  "IntentLens: 查看索引范围与遗漏原因"
                                         },
                                         {
                                             "command":  "intentlens.startRound",
                                             "title":  "IntentLens: 开始记录本轮修改",
                                             "description":  "以当前磁盘状态开始一个本地轮次"
                                         },
                                         {
                                             "command":  "intentlens.stopRound",
                                             "title":  "IntentLens: 结束记录本轮修改",
                                             "description":  "以当前磁盘状态结束本地轮次"
                                         },
                                         {
                                             "command":  "intentlens.resumeRound",
                                             "title":  "IntentLens: 恢复未结束的轮次"
                                         },
                                         {
                                             "command":  "intentlens.cancelRound",
                                             "title":  "IntentLens: 取消当前轮次（保留源码）"
                                         },
                                         {
                                             "command":  "intentlens.status",
                                             "title":  "IntentLens: 查看状态与预算"
                                         },
                                         {
                                             "command":  "intentlens.enableModel",
                                             "title":  "IntentLens: 启用或调整模型分析"
                                         },
                                         {
                                             "command":  "intentlens.testModel",
                                             "title":  "IntentLens: 测试当前模型 API（只发送固定探针）"
                                         },
                                         {
                                             "command":  "intentlens.pauseModel",
                                             "title":  "IntentLens: 暂停模型分析"
                                         },
                                         {
                                             "command":  "intentlens.hooksConfig",
                                             "title":  "IntentLens: 预览 Claude Code Hook 配置"
                                         },
                                         {
                                             "command":  "intentlens.showRestrictionDetails",
                                             "title":  "IntentLens: 显示解析限制详情"
                                         },
                                         {
                                             "command":  "intentlens.navigateToRestriction",
                                             "title":  "IntentLens: 跳转到限制位置"
                                         },
                                         {
                                             "command":  "intentlens.refreshRestrictions",
                                             "title":  "IntentLens: 刷新解析限制",
                                             "icon":  "$(refresh)"
                                         },
                                         {
                                             "command":  "intentlens.clearRestrictions",
                                             "title":  "IntentLens: 清除解析限制",
                                             "icon":  "$(clear-all)"
                                         },
                                         {
                                             "command":  "intentlens.configureAPI",
                                             "title":  "IntentLens: 配置 AI API 和选择模型"
                                         },
                                         {
                                             "command":  "intentlens.viewTokenUsage",
                                             "title":  "IntentLens: 查看 Token 消耗与预算"
                                         }
                                     ],
                        "viewsContainers":  {
                                                "activitybar":  [
                                                                    {
                                                                        "id":  "intentlens",
                                                                        "title":  "IntentLens",
                                                                        "icon":  "./media/callpath.svg"
                                                                    }
                                                                ]
                                            },
                        "views":  {
                                      "explorer":  [
                                                       {
                                                           "id":  "intentlens.rounds",
                                                           "name":  "IntentLens · 轮次"
                                                       }
                                                   ],
                                      "intentlens":  [
                                                         {
                                                             "id":  "intentlens.callPath",
                                                             "name":  "调用路径（源码证据）"
                                                         },
                                                         {
                                                             "id":  "intentlens.modelAnswer",
                                                             "name":  "模型回答与证据"
                                                         },
                                                         {
                                                             "id":  "intentlens.restrictions",
                                                             "name":  "解析限制（统一视图）"
                                                         }
                                                     ]
                                  },
                        "viewsWelcome":  [
                                             {
                                                 "view":  "intentlens.rounds",
                                                 "contents":  "打开并信任本地 Go 工作区。可手动记录轮次，也可通过 Skill / CLI 接入；Claude hooks 为可选适配。\n[⚙️ 配置 AI API](command:intentlens.configureAPI)\n[📊 查看 Token 消耗](command:intentlens.viewTokenUsage)\n[开始记录](command:intentlens.startRound)\n[结束记录](command:intentlens.stopRound)\n[恢复未结束轮次](command:intentlens.resumeRound)\n[取消当前轮次（保留源码）](command:intentlens.cancelRound)\n[预览可选 Claude Hook](command:intentlens.hooksConfig)\n[刷新](command:intentlens.refresh)"
                                             },
                                             {
                                                 "view":  "intentlens.callPath",
                                                 "contents":  "在本地 Go 文件中放置光标后加载调用路径；受限工作区不会执行 CLI。\n[显示调用路径](command:intentlens.callPath)\n[刷新调用路径](command:intentlens.refreshCallPath)"
                                             },
                                             {
                                                 "view":  "intentlens.modelAnswer",
                                                 "contents":  "只读显示当前函数已保存在本地的回答、历史版本和引用证据。打开或刷新视图不会发起模型请求。\n[刷新模型回答与证据](command:intentlens.refreshModelAnswer)"
                                             },
                                             {
                                                 "view":  "intentlens.restrictions",
                                                 "contents":  "解析限制统一显示。所有代码解析错误、类型检查错误和限制将在此汇总显示。\n[刷新解析限制](command:intentlens.refreshRestrictions)\n[清除解析限制](command:intentlens.clearRestrictions)"
                                             }
                                         ],
                        "menus":  {
                                      "editor/context":  [
                                                             {
                                                                 "command":  "intentlens.explainSelection",
                                                                 "when":  "editorTextFocus \u0026\u0026 editorHasSelection",
                                                                 "group":  "navigation@1"
                                                             }
                                                         ],
                                      "view/title":  [
                                                         {
                                                             "command":  "intentlens.configureAPI",
                                                             "when":  "view == intentlens.rounds",
                                                             "group":  "config@1"
                                                         },
                                                         {
                                                             "command":  "intentlens.viewTokenUsage",
                                                             "when":  "view == intentlens.rounds",
                                                             "group":  "config@2"
                                                         },
                                                         {
                                                             "command":  "intentlens.refresh",
                                                             "when":  "view == intentlens.rounds",
                                                             "group":  "navigation"
                                                         },
                                                         {
                                                             "command":  "intentlens.refreshCallPath",
                                                             "when":  "view == intentlens.callPath",
                                                             "group":  "navigation"
                                                         },
                                                         {
                                                             "command":  "intentlens.refreshModelAnswer",
                                                             "when":  "view == intentlens.modelAnswer",
                                                             "group":  "navigation"
                                                         },
                                                         {
                                                             "command":  "intentlens.testModel",
                                                             "when":  "view == intentlens.rounds",
                                                             "group":  "model@2"
                                                         },
                                                         {
                                                             "command":  "intentlens.startRound",
                                                             "when":  "view == intentlens.rounds",
                                                             "group":  "capture@1"
                                                         },
                                                         {
                                                             "command":  "intentlens.stopRound",
                                                             "when":  "view == intentlens.rounds",
                                                             "group":  "capture@2"
                                                         },
                                                         {
                                                             "command":  "intentlens.resumeRound",
                                                             "when":  "view == intentlens.rounds",
                                                             "group":  "capture@3"
                                                         },
                                                         {
                                                             "command":  "intentlens.cancelRound",
                                                             "when":  "view == intentlens.rounds",
                                                             "group":  "capture@4"
                                                         },
                                                         {
                                                             "command":  "intentlens.refreshRestrictions",
                                                             "when":  "view == intentlens.restrictions",
                                                             "group":  "navigation"
                                                         },
                                                         {
                                                             "command":  "intentlens.clearRestrictions",
                                                             "when":  "view == intentlens.restrictions",
                                                             "group":  "navigation"
                                                         }
                                                     ]
                                  },
                        "configuration":  {
                                              "title":  "IntentLens",
                                              "properties":  {
                                                                 "intentlens.binaryPath":  {
                                                                                               "type":  "string",
                                                                                               "default":  "",
                                                                                               "scope":  "machine-overridable",
                                                                                               "restricted":  true,
                                                                                               "description":  "IntentLens executable path. Empty uses bundled bin/intentlens(.exe), then PATH. No shell arguments."
                                                                                           },
                                                                 "intentlens.restrictionsAggregation":  {
                                                                                                            "type":  "boolean",
                                                                                                            "default":  true,
                                                                                                            "scope":  "window",
                                                                                                            "description":  "Enable unified display for parse restrictions (aggregates multiple errors into hierarchical view)"
                                                                                                        }
                                                             }
                                          }
                    }
}
